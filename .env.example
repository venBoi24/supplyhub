# Copy to .env and replace placeholders. Never commit real credentials.

# Public absolute URL of the storefront.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string. Required at runtime.
# Local development option: run `npm run db:dev` and copy the printed URL here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supplyhub?schema=public"

# Supabase alternative. These exact key names are read by the app and by Prisma migrations,
# so keep them unchanged when setting Vercel environment variables. A remote DATABASE_URL
# always wins; on Vercel the transaction pooler is used when DATABASE_URL is a localhost URL.
# The app rewrites Supabase URLs to `sslmode=no-verify` because the pooler presents a private
# CA; traffic is still encrypted. Migrations use the session pooler (port 5432).
# SUPABASE_TRANSACTION_POOLER_KEY="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# SUPABASE_SESSION_POOLER_KEY="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# SUPPABASE_Direct_connection_KEY="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# Signs Auth.js session cookies. Required. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-value"

# Optional canonical origin for Auth.js in production (for example https://supplyhub.example).
# AUTH_URL=""

# Minutes an unpaid order holds reserved stock before the reservation is released.
# This is a configurable default; docs/01-product-vision.md leaves the policy unresolved.
CHECKOUT_RESERVATION_MINUTES="15"

# Separate database for the PostgreSQL checkout integration gate. When set, `npm run test`
# runs the integration suite against it, so it must have migrations applied.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supplyhub_test?schema=public"

# Not read yet. Required from Phase 4 when uploads are enabled.
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# LynxPay payments. Required to enable payments; the site builds and serves without them, but
# starting a payment fails. A production key must begin with lynx_live_sk_; sandbox keys are only
# accepted outside production. The webhook secret signs X-Lynx-Signature headers; the previous
# secret stays valid for 24 hours during rotation.
# PAYMENT_PROVIDER="lynxpay"
# LYNXPAY_API_KEY="lynx_test_sk_..."
# LYNXPAY_SIGNING_SECRET="..."
# LYNXPAY_WEBHOOK_SECRET="..."
# LYNXPAY_WEBHOOK_SECRET_PREVIOUS=""
# LYNXPAY_BASE_URL="https://api.lynxpay.africa"

# Platform commission in basis points applied to each studio subtotal. This is a configurable
# default, not settled policy; see docs/01-product-vision.md.
# PLATFORM_COMMISSION_BPS="1000"
# COMMISSION_RULE_VERSION="configurable-default-v1"
