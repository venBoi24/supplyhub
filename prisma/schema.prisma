generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ProductImageStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryReason {
  INITIAL
  RESTOCK
  CORRECTION
  RETURN
  SALE
  RELEASE
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum AuditAction {
  VENDOR_APPLICATION_SUBMITTED
  VENDOR_APPROVED
  VENDOR_REJECTED
  PRODUCT_CREATED
  PRODUCT_SUBMITTED
  PRODUCT_PUBLISHED
  PRODUCT_REJECTED
  PRODUCT_ARCHIVED
  PRODUCT_FEATURED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_ARCHIVED
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_EXPIRED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  name               String
  passwordHash       String?             @map("password_hash")
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamptz(6)
  role               UserRole            @default(CUSTOMER)
  status             UserStatus          @default(ACTIVE)
  sessionVersion     Int                 @default(0) @map("session_version")
  vendor             Vendor?             @relation("VendorOwner")
  reviewedVendors    Vendor[]            @relation("VendorReviewer")
  reviewedProducts   Product[]           @relation("ProductReviewer")
  inventoryMovements InventoryMovement[] @relation("InventoryActor")
  accountTokens      AccountToken[]
  auditEvents        AuditLog[]          @relation("AuditActor")
  cart               Cart?
  orders             Order[]             @relation("CustomerOrders")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role, status])
  @@map("users")
}

model Vendor {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String        @unique @map("owner_id") @db.Uuid
  owner        User          @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name         String
  slug         String        @unique
  description  String?
  monogram     String?
  location     String?
  discipline   String?
  story        String?
  status       VendorStatus  @default(PENDING)
  reviewNote   String?       @map("review_note")
  reviewedAt   DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewedById String?       @map("reviewed_by_id") @db.Uuid
  reviewedBy   User?         @relation("VendorReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  products     Product[]
  vendorOrders VendorOrder[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([status, createdAt])
  @@map("vendors")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  parentId    String?        @map("parent_id") @db.Uuid
  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]     @relation("CategoryHierarchy")
  name        String
  slug        String         @unique
  headline    String         @default("")
  description String         @default("")
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  products    Product[]
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, sortOrder])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  vendorId           String              @map("vendor_id") @db.Uuid
  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  categoryId         String              @map("category_id") @db.Uuid
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug               String              @unique
  name               String
  sku                String
  summary            String
  description        String
  makerNote          String              @default("") @map("maker_note")
  materials          String[]            @default([])
  dimensions         String              @default("")
  care               String              @default("")
  searchText         String              @default("") @map("search_text")
  price              Decimal             @db.Decimal(12, 2)
  compareAtPrice     Decimal?            @map("compare_at_price") @db.Decimal(12, 2)
  currency           String              @default("USD") @db.VarChar(3)
  stock              Int                 @default(0)
  status             ProductStatus       @default(DRAFT)
  featured           Boolean             @default(false)
  reviewNote         String?             @map("review_note")
  reviewedAt         DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  reviewedById       String?             @map("reviewed_by_id") @db.Uuid
  reviewedBy         User?               @relation("ProductReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt        DateTime?           @map("submitted_at") @db.Timestamptz(6)
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(6)
  archivedAt         DateTime?           @map("archived_at") @db.Timestamptz(6)
  images             ProductImage[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendorId, sku])
  @@index([vendorId, status])
  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([status, featured])
  @@map("products")
}

model ProductImage {
  id          String             @id @default(uuid()) @db.Uuid
  productId   String             @map("product_id") @db.Uuid
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey  String             @unique @map("storage_key")
  alt         String
  contentType String             @map("content_type")
  byteSize    Int                @map("byte_size")
  sortOrder   Int                @default(0) @map("sort_order")
  status      ProductImageStatus @default(APPROVED)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model InventoryMovement {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorId        String?         @map("actor_id") @db.Uuid
  actor          User?           @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  delta          Int
  reason         InventoryReason
  resultingStock Int             @map("resulting_stock")
  note           String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @unique @map("user_id") @db.Uuid
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestTokenHash String?    @unique @map("guest_token_hash")
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(6)
  items          CartItem[]
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id                   String        @id @default(uuid()) @db.Uuid
  orderNumber          String        @unique @map("order_number")
  customerId           String        @map("customer_id") @db.Uuid
  customer             User          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  status               OrderStatus   @default(AWAITING_PAYMENT)
  currency             String        @db.VarChar(3)
  subtotal             Decimal       @db.Decimal(12, 2)
  shippingTotal        Decimal       @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal             Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal        Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  total                Decimal       @db.Decimal(12, 2)
  recipientName        String        @map("recipient_name")
  contactEmail         String        @map("contact_email")
  contactPhone         String?       @map("contact_phone")
  addressLine1         String        @map("address_line1")
  addressLine2         String?       @map("address_line2")
  city                 String
  region               String
  postalCode           String        @map("postal_code")
  countryCode          String        @map("country_code") @db.VarChar(2)
  reservationExpiresAt DateTime?     @map("reservation_expires_at") @db.Timestamptz(6)
  placedAt             DateTime      @default(now()) @map("placed_at") @db.Timestamptz(6)
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz(6)
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  vendorOrders         VendorOrder[]
  items                OrderItem[]
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId, createdAt])
  @@index([status, reservationExpiresAt])
  @@map("orders")
}

model VendorOrder {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorId  String      @map("vendor_id") @db.Uuid
  vendor    Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status    OrderStatus @default(AWAITING_PAYMENT)
  currency  String      @db.VarChar(3)
  subtotal  Decimal     @db.Decimal(12, 2)
  items     OrderItem[]
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orderId, vendorId])
  @@index([vendorId, status, createdAt])
  @@map("vendor_orders")
}

model OrderItem {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @map("order_id") @db.Uuid
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrderId String      @map("vendor_order_id") @db.Uuid
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  productId     String?     @map("product_id") @db.Uuid
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String      @map("product_name")
  productSlug   String      @map("product_slug")
  sku           String
  imageKey      String?     @map("image_key")
  unitPrice     Decimal     @map("unit_price") @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal     @map("line_total") @db.Decimal(12, 2)
  currency      String      @db.VarChar(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([vendorOrderId])
  @@map("order_items")
}

model AccountToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AccountTokenPurpose
  tokenHash String              @unique @map("token_hash")
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("account_tokens")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  targetType String      @map("target_type")
  targetId   String?     @map("target_id")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
